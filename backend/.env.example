NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Local mongod, or an Atlas driver string. Two things people miss with Atlas:
#   - replace <password> with the real password
#   - add the database name before the "?", e.g. .mongodb.net/reclaimos?retryWrites=true
MONGODB_URI=mongodb://127.0.0.1:27017/reclaimos

# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

LOG_LEVEL=info

# ── Mail ────────────────────────────────────────────────────────────────────
# Where outgoing mail goes.
#   file   an .eml written to MAIL_OUTBOX — open it in any mail client. The
#          default, so a fresh clone can exercise password reset with no account
#          at an email provider.
#   smtp   a real server, from the settings below. Required in production: the
#          process refuses to start otherwise, because mail that silently goes
#          nowhere is how password reset was broken for weeks.
#   log    a log line and nothing else. Used by the test suite.
MAIL_TRANSPORT=file
MAIL_FROM=ReclaimOS <no-reply@reclaimos.local>
MAIL_OUTBOX=.outbox

# Only read when MAIL_TRANSPORT=smtp.
# SMTP_SECURE=true means implicit TLS (port 465); false means STARTTLS (587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
