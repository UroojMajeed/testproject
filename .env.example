# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/reclaimos
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# 32-byte hex key for AES-256-GCM encryption of integration OAuth tokens
ENCRYPTION_KEY=

# ── AI ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_MONTHLY_CAP_MINOR=50000

# ── OAuth ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Email / Storage / Billing ────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@reclaimos.app
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Client (Vite) ────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api/v1
